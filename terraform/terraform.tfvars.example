# Copy to terraform.tfvars and edit. Never commit the real tfvars file.

project_name    = "simple-cicd"
environment     = "prod"
aws_region      = "eu-central-1"

instance_type   = "t3.micro"
root_volume_size = 20

# Published on port 80 -> container listens on 3000.
http_port      = 80
container_port = 3000

# Limit SSH to your own IP. Leave as [] to disable SSH and use SSM Session Manager:
#   aws ssm start-session --target <instance-id>
ssh_allowed_cidrs = ["203.0.113.10/32"]

# Tag deployed by Terraform on the first apply; CI/CD takes over afterwards.
image_tag = "latest"

tags = {
  Owner = "platform-team"
}